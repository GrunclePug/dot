             output.lock_surface.?.ackConfigure(ev.serial);
+            output.configure_bg();
             output.attach_buffer(lock.buffers[@intFromEnum(lock.color)]);
         },
     }
 }
 
+/// The subsurface is synchronized, so this takes effect on the next commit of the parent.
+fn configure_bg(output: *Output) void {
+    const bg_surface = output.bg_surface orelse return;
+    const border = output.lock.border_width;
+    if (output.width <= 2 * border or output.height <= 2 * border) {
+        bg_surface.attach(null, 0, 0);
+    } else {
+        output.bg_subsurface.?.setPosition(border, border);
+        bg_surface.attach(output.lock.bg_buffer.?, 0, 0);
+        bg_surface.damageBuffer(0, 0, math.maxInt(i32), math.maxInt(i32));
+        output.bg_viewport.?.setDestination(output.width - 2 * border, output.height - 2 * border);
+    }
+    bg_surface.commit();
+}
+
 pub fn attach_buffer(output: *Output, buffer: *wl.Buffer) void {
     if (!output.configured) return;
     output.surface.?.attach(buffer, 0, 0);
