{
  "//": "prof playground: mango 'flat' bar. dwm's layout, edge to edge: tags | layout symbol | focused window ... status | clock | tray. Style: waybar.css next to this file.",
  "layer": "top",
  "position": "top",
  "height": 22,
  "spacing": 0,
  "modules-left": ["ext/workspaces", "custom/layout", "custom/title"],
  "modules-right": ["cpu", "memory", "battery", "wireplumber", "clock", "tray"],

  "ext/workspaces": { "format": "{name}", "on-click": "activate", "sort-by-id": true, "ignore-hidden": false },
  "//custom/layout": "dwm's layout symbol, from mango's IPC (pg-mango-layout). Click to cycle tile/monocle like Alt+space.",
  "custom/layout": { "exec": "pg-mango-layout", "on-click": "mmsg dispatch switch_layout", "tooltip": false },
  "//custom/title": "dwm's focused-window title, from mango's IPC (pg-mango-title).",
  "custom/title": { "exec": "pg-mango-title", "max-length": 80, "escape": true, "tooltip": false },

  "cpu": { "interval": 2, "format": "cpu {usage}%", "tooltip": false },
  "memory": { "interval": 2, "format": "mem {used:0.1f}G", "tooltip-format": "{used:0.1f} / {total:0.1f} GiB" },
  "battery": {
    "bat": "BAT0",
    "interval": 5,
    "states": { "warning": 25, "critical": 12 },
    "format": "bat {capacity}%",
    "format-charging": "bat {capacity}%+",
    "format-plugged": "bat {capacity}%=",
    "tooltip-format": "{timeTo}"
  },
  "wireplumber": {
    "format": "vol {volume}%",
    "format-muted": "vol mute",
    "scroll-step": 5,
    "max-volume": 100,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "tooltip-format": "{node_name}"
  },
  "clock": {
    "interval": 1,
    "format": "{:%a %d %b %H:%M:%S}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": { "mode": "month", "format": { "today": "<span color='#5fd4c4'><b>{}</b></span>" } }
  },
  "tray": { "spacing": 6, "icon-size": 14 }
}
