# Shared git settings. Your name and email stay out of here (this repository
# is public): each machine keeps them in ~/.gitconfig, which git also reads.
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	light = false
	side-by-side = false
	line-numbers = true
[merge]
	conflictstyle = zdiff3

# GitHub over HTTPS without typing a token: git asks gh for it. Log in once
# per machine with 'gh auth login'.
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
