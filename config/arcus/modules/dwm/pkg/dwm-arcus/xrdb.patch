+void
+loadxrdb(void)
+{
+	char *rm, *type;
+	unsigned int i;
+	XrmDatabase db;
+	XrmValue v;
+
+	if (!(rm = XResourceManagerString(dpy)))
+		return;
+	XrmInitialize();
+	if (!(db = XrmGetStringDatabase(rm)))
+		return;
+	for (i = 0; i < LENGTH(xrdbcolors); i++)
+		if (XrmGetResource(db, xrdbcolors[i].name, xrdbcolors[i].name, &type, &v)
+		&& v.addr && v.addr[0] == '#' && strlen(v.addr) == 7)
+			strcpy(xrdbcolors[i].color, v.addr);
+	XrmDestroyDatabase(db);
+}
