+/*
+ * X resources that override the colours of config.h: st.color0 to
+ * st.color15, st.foreground, st.background and st.cursorColor.
+ */
+void
+loadxrdb(void)
+{
+	const struct {
+		const char *name;
+		unsigned int idx;
+	} named[] = {
+		{ "st.foreground",  defaultfg },
+		{ "st.background",  defaultbg },
+		{ "st.cursorColor", defaultcs },
+	};
+	char *rm, *type, name[16];
+	unsigned int i;
+	XrmDatabase db;
+	XrmValue v;
+
+	if (!(rm = XResourceManagerString(xw.dpy)))
+		return;
+	XrmInitialize();
+	if (!(db = XrmGetStringDatabase(rm)))
+		return;
+	for (i = 0; i < 16 + LEN(named); i++) {
+		if (i < 16)
+			snprintf(name, sizeof(name), "st.color%u", i);
+		else
+			snprintf(name, sizeof(name), "%s", named[i - 16].name);
+		if (XrmGetResource(db, name, name, &type, &v) && v.addr && v.addr[0] == '#')
+			colorname[i < 16 ? i : named[i - 16].idx] = xstrdup(v.addr);
+	}
+	XrmDestroyDatabase(db);
+}
