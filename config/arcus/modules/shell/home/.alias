# eza for listings (agents don't get these: .bashrc stops early in non-interactive shells)
alias ls='eza --group-directories-first --icons=auto'
alias ll='eza -l --git --group-directories-first --icons=auto'
alias la='eza -la --git --group-directories-first --icons=auto'
alias tree='eza -T --icons=auto'
alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias dust='dust --reverse'
alias ff='fastfetch'
alias agx='agy --dangerously-skip-permissions'
alias why='agy --model gemini-3-8-flash "Analyze this terminal output. Point out the exact error, why it happened, and give the one command to fix it without fluff."'
# The homelab WireGuard connection (a NetworkManager profile on the laptop)
alias vpn-up='nmcli connection up Homelab-laptop'
alias vpn-down='nmcli connection down Homelab-laptop'
