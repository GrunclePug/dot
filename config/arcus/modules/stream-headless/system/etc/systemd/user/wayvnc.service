[Unit]
Description=wayvnc: the headless stream session over VNC, on this machine only
BindsTo=stream-headless.service
After=stream-headless.service
StartLimitIntervalSec=0

[Service]
Environment=WAYLAND_DISPLAY=wayland-stream
# With no address it listens on loopback, port 5900.
ExecStart=/usr/bin/wayvnc
Restart=always
RestartSec=2

[Install]
WantedBy=stream-headless.service
