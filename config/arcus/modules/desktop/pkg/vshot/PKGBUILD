# vshot: screen selection and capture for X11 and Wayland.
# Pinned to a commit on GitHub. To update: move _commit and pkgver together
# (pkgver is VERSION from config.mk, then the commit count and short hash:
# git rev-list --count <commit>).
pkgname=vshot
pkgver=0.1.0.r11.g1fb7a84
_commit=1fb7a84e4fa5264586c0699e8fb0f41288c9ef71
pkgrel=2
pkgdesc="Screen selection and capture tool for X11 and Wayland"
arch=(x86_64)
url="https://github.com/GrunclePug/vshot"
license=(MIT)
depends=(glibc libxkbcommon)
makedepends=(git go pkgconf)
optdepends=('xclip: copy to the clipboard on X11'
            'wl-clipboard: copy to the clipboard on Wayland')
source=("$pkgname::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

# Go's module cache stays in the build directory, not in ~/go: builds run
# in a clean environment (the installer, arcus apply), not your shell.
prepare() {
  cd $pkgname
  GOPATH="$srcdir/go" GOFLAGS=-modcacherw go mod download
}

# vshot needs cgo (libxkbcommon), so the build follows Arch's Go package
# guidelines: makepkg's C flags for cgo, PIE and external linking.
build() {
  cd $pkgname
  export GOPATH="$srcdir/go"
  export CGO_CPPFLAGS="$CPPFLAGS" CGO_CFLAGS="$CFLAGS" CGO_CXXFLAGS="$CXXFLAGS" CGO_LDFLAGS="$LDFLAGS"
  make GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw" LDFLAGS="-linkmode=external -X main.Version=${pkgver%%.r*}"
}

package() {
  cd $pkgname
  make PREFIX=/usr DESTDIR="$pkgdir" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
