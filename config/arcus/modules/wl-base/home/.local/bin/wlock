#!/usr/bin/env bash
# patched waylock (package waylock-arcus, recipe in this module's pkg/), with
# slock's border; colours from the active theme.
. "$HOME/.config/theme/colors.sh"
exec waylock \
	-border-width 4 \
	-bg-color 0x000000 \
	-init-color 0x000000 \
	-input-color "0x$lock_input" \
	-fail-color "0x$urgent" \
	"$@"
