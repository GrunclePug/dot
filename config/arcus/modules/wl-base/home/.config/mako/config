# The shared notifications, laid out like dunst; colours come from the active theme.
font=monospace 8
width=300
anchor=top-right
outer-margin=33,12,0,0
margin=0,0,2,0
padding=8
border-size=1
format=<b>%s</b>\n%b
markup=1
default-timeout=10000
max-visible=20

include=~/.config/mako/theme

[urgency=critical]
default-timeout=0
