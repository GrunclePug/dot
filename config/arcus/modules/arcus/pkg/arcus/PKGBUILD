# arcus, built from a release on GitHub.
# Pinned to the commit of the release tag. To update: set pkgver to the new
# version and _commit to its tag's commit (git rev-parse v<version>^{commit}).
pkgname=arcus
pkgver=0.1.0
_commit=84d461afd02fdf903f2c6fc00a162e65e253346a   # v$pkgver
pkgrel=1
pkgdesc="Install Arch Linux and manage it as a stack of small, swappable modules"
arch=(x86_64)
url="https://github.com/grunclepug/arcus"
license=(MIT)
depends=(pacman sudo)
makedepends=(git go)
optdepends=('yay: AUR packages'
            'paru: AUR packages'
            'base-devel: own builds')
source=("$pkgname::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

prepare() {
  cd $pkgname
  go mod download
}

# The Makefile builds the static, pure Go binary the project ships.
build() {
  cd $pkgname
  make bin/arcus
}

check() {
  cd $pkgname
  make test
}

package() {
  cd $pkgname
  make PREFIX=/usr DESTDIR="$pkgdir" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
