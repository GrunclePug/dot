# river's notifications: square and flat; colours come from the active theme.
font=JetBrainsMono Nerd Font 10
width=340
anchor=top-right
outer-margin=8,8,0,0
margin=0,0,8,0
padding=10,12
border-size=2
border-radius=0
format=<b>%s</b>\n%b
markup=1
default-timeout=8000
max-visible=6

include=~/.config/theme/mako

[urgency=critical]
default-timeout=0
