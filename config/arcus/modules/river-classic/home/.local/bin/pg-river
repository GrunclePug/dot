#!/bin/sh
# prof playground launcher: run from a TTY (the startx of this profile).
export PATH="$HOME/.local/bin:$PATH"
export XDG_CURRENT_DESKTOP=river XDG_SESSION_TYPE=wayland XDG_SESSION_DESKTOP=river
# Qt apps take their colours from the GTK theme (gtk.css, so the active theme).
export MOZ_ENABLE_WAYLAND=1 QT_QPA_PLATFORM="wayland;xcb" QT_QPA_PLATFORMTHEME=gtk3 SDL_VIDEODRIVER="wayland,x11"
exec river "$@"
