#!/usr/bin/env python3
import os
import sys
import signal
import subprocess
import gi

gi.require_version('Gtk', '3.0')
gi.require_version('GtkLayerShell', '0.1')
from gi.repository import Gtk, GtkLayerShell, Gdk, GLib

PID_FILE = "/tmp/pg-vol-slider.pid"
CSS_PATH = os.path.expanduser("~/.config/river/waybar.css")

def check_single_instance():
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
            os.kill(pid, signal.SIGTERM)
            try:
                os.remove(PID_FILE)
            except Exception:
                pass
            sys.exit(0)
        except (ValueError, ProcessLookupError, PermissionError):
            pass
    try:
        with open(PID_FILE, "w") as f:
            f.write(str(os.getpid()))
    except Exception:
        pass

def cleanup(*args):
    try:
        if os.path.exists(PID_FILE):
            os.remove(PID_FILE)
    except Exception:
        pass
    Gtk.main_quit()

def get_volume():
    try:
        out = subprocess.check_output(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], text=True)
        parts = out.strip().split()
        vol = float(parts[1]) if len(parts) > 1 else 1.0
        muted = "[MUTED]" in out
        return int(round(vol * 100)), muted
    except Exception:
        return 50, False

def set_volume(val):
    val_clamped = max(0, min(150, int(round(val))))
    subprocess.run(["wpctl", "set-volume", "-l", "1.5", "@DEFAULT_AUDIO_SINK@", f"{val_clamped/100.0:.2f}"])

def toggle_mute():
    subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"])

class VolumeSlider(Gtk.Window):
    def __init__(self, margin_right=226, margin_top=26):
        super().__init__()
        self.updating = False

        # Layer Shell setup
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.EXCLUSIVE)
        for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM,
                     GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(self, edge, True)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)

        # Transparent window background
        base_provider = Gtk.CssProvider()
        base_provider.load_from_data(b"window { background-color: transparent; }")
        Gtk.StyleContext.add_provider_for_screen(screen, base_provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        # Load user's river-classic theme directly from waybar.css
        if os.path.exists(CSS_PATH):
            theme_provider = Gtk.CssProvider()
            try:
                theme_provider.load_from_path(CSS_PATH)
                Gtk.StyleContext.add_provider_for_screen(screen, theme_provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
            except Exception as e:
                print(f"Warning: could not load {CSS_PATH}: {e}", file=sys.stderr)

        overlay = Gtk.Overlay()

        # Backdrop: clicking anywhere outside closes the popup
        backdrop = Gtk.EventBox()
        backdrop.connect("button-press-event", lambda w, e: cleanup())
        overlay.add(backdrop)

        # Positioned container below the Waybar volume module
        pos_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        pos_box.set_halign(Gtk.Align.END)
        pos_box.set_valign(Gtk.Align.START)
        pos_box.set_margin_top(margin_top)
        pos_box.set_margin_end(margin_right)

        self.card = Gtk.EventBox()
        self.card.set_name("slider-card")
        self.card.connect("button-press-event", lambda w, e: True)
        self.card.connect("scroll-event", self.on_scroll)

        inner_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        inner_box.set_size_request(32, 160)

        vol, muted = get_volume()
        self.is_muted = muted

        # Volume label (clickable to toggle mute)
        label_event = Gtk.EventBox()
        label_event.connect("button-press-event", self.on_label_click)
        self.label = Gtk.Label()
        self.label.set_name("vol-label")
        label_event.add(self.label)
        inner_box.pack_start(label_event, False, False, 0)

        # Scale / Slider: 0 to 150 by default
        self.adj = Gtk.Adjustment(value=vol, lower=0, upper=150, step_increment=1, page_increment=5)
        self.scale = Gtk.Scale(orientation=Gtk.Orientation.VERTICAL, adjustment=self.adj)
        self.scale.set_inverted(True)
        self.scale.set_draw_value(False)
        self.scale.connect("change-value", self.on_scale_change_value)
        self.scale.connect("value-changed", self.on_scale_value_changed)
        self.scale.connect_after("draw", self.on_scale_draw)
        inner_box.pack_start(self.scale, True, True, 2)

        self.card.add(inner_box)
        pos_box.pack_start(self.card, False, False, 0)
        overlay.add_overlay(pos_box)

        self.add(overlay)
        self.connect("key-press-event", self.on_key_press)
        self.update_ui(vol, muted)

    def on_scale_draw(self, scale, cr):
        alloc = scale.get_allocation()
        slider_len = 14.0
        usable_h = alloc.height - slider_len
        # Inverted vertical scale 0..150: value 100 is (150 - 100) / 150 = 1/3 from top
        y = slider_len / 2.0 + (50.0 / 150.0) * usable_h
        cx = alloc.width / 2.0

        # Draw a clean horizontal threshold notch across the trough at 100%
        cr.save()
        cr.set_line_width(2.0)
        cr.set_source_rgba(0.95, 0.77, 0.43, 0.9)  # @gold color
        cr.move_to(cx - 6, y)
        cr.line_to(cx + 6, y)
        cr.stroke()
        cr.restore()
        return False

    def update_ui(self, vol, muted):
        self.is_muted = muted
        card_ctx = self.card.get_style_context()
        lbl_ctx = self.label.get_style_context()
        scale_ctx = self.scale.get_style_context()

        if muted:
            self.label.set_text("MUTE")
            lbl_ctx.add_class("muted")
            lbl_ctx.remove_class("boost")
            card_ctx.add_class("muted")
            card_ctx.remove_class("boosted")
            scale_ctx.remove_class("boost")
        elif vol > 100:
            self.label.set_text(f"{vol}%")
            lbl_ctx.add_class("boost")
            lbl_ctx.remove_class("muted")
            card_ctx.add_class("boosted")
            card_ctx.remove_class("muted")
            scale_ctx.add_class("boost")
        else:
            self.label.set_text(f"{vol}%")
            lbl_ctx.remove_class("boost")
            lbl_ctx.remove_class("muted")
            card_ctx.remove_class("boosted")
            card_ctx.remove_class("muted")
            scale_ctx.remove_class("boost")

    def on_label_click(self, widget, event):
        toggle_mute()
        vol, muted = get_volume()
        self.update_ui(vol, muted)
        return True

    def on_scale_change_value(self, scale, scroll_type, value):
        if self.updating:
            return False
        # Sticky detent around 100%: snaps firmly to 100 between 96 and 104
        if 96.0 <= value <= 104.0:
            scale.set_value(100.0)
            set_volume(100)
            self.update_ui(100, False)
            return True
        return False

    def on_scale_value_changed(self, scale):
        if self.updating:
            return
        val = int(round(scale.get_value()))
        set_volume(val)
        self.update_ui(val, False)

    def on_scroll(self, widget, event):
        cur = self.adj.get_value()
        if event.direction == Gdk.ScrollDirection.UP:
            new_val = min(150, cur + 5)
        elif event.direction == Gdk.ScrollDirection.DOWN:
            new_val = max(0, cur - 5)
        else:
            return False

        if 96.0 <= new_val <= 104.0:
            new_val = 100.0

        self.updating = True
        self.scale.set_value(new_val)
        self.updating = False
        set_volume(new_val)
        self.update_ui(int(round(new_val)), False)
        return True

    def on_key_press(self, widget, event):
        if event.keyval in (Gdk.KEY_Escape, Gdk.KEY_q, Gdk.KEY_Return, Gdk.KEY_space):
            cleanup()
            return True
        elif event.keyval in (Gdk.KEY_Up, Gdk.KEY_k):
            cur = self.adj.get_value()
            new_val = min(150, cur + 5)
            if 96.0 <= new_val <= 104.0:
                new_val = 100.0
            self.scale.set_value(new_val)
            return True
        elif event.keyval in (Gdk.KEY_Down, Gdk.KEY_j):
            cur = self.adj.get_value()
            new_val = max(0, cur - 5)
            if 96.0 <= new_val <= 104.0:
                new_val = 100.0
            self.scale.set_value(new_val)
            return True
        elif event.keyval == Gdk.KEY_m:
            toggle_mute()
            vol, muted = get_volume()
            self.update_ui(vol, muted)
            return True
        return False

def main():
    check_single_instance()
    signal.signal(signal.SIGINT, cleanup)
    signal.signal(signal.SIGTERM, cleanup)

    margin_right = 226
    if len(sys.argv) > 1:
        try:
            margin_right = int(sys.argv[1])
        except ValueError:
            pass

    win = VolumeSlider(margin_right=margin_right)
    win.show_all()
    Gtk.main()

if __name__ == '__main__':
    main()
