{
  "//": "stream's bar: tags, layout, mode and the focused window from streamctl waybar (one process per module, for this bar's monitor), then status, clock and tray. Style: waybar.css next to this file.",
  "layer": "top",
  "position": "top",
  "height": 22,
  "spacing": 0,
  "modules-left": ["custom/tag-1", "custom/tag-2", "custom/tag-3", "custom/tag-4", "custom/tag-5", "custom/tag-6", "custom/tag-7", "custom/tag-8", "custom/tag-9", "custom/layout", "custom/mode", "custom/title"],
  "modules-right": ["cpu", "memory", "battery", "wireplumber", "clock", "tray"],

  "//tags": "Like dwm's tag bar: click views the tag, right click adds it to the view.",
  "custom/tag-1": {
    "exec": "streamctl waybar tag 1",
    "return-type": "json",
    "on-click": "streamctl view 1",
    "on-click-right": "streamctl toggle-view 1",
    "tooltip": false
  },
  "custom/tag-2": {
    "exec": "streamctl waybar tag 2",
    "return-type": "json",
    "on-click": "streamctl view 2",
    "on-click-right": "streamctl toggle-view 2",
    "tooltip": false
  },
  "custom/tag-3": {
    "exec": "streamctl waybar tag 3",
    "return-type": "json",
    "on-click": "streamctl view 3",
    "on-click-right": "streamctl toggle-view 3",
    "tooltip": false
  },
  "custom/tag-4": {
    "exec": "streamctl waybar tag 4",
    "return-type": "json",
    "on-click": "streamctl view 4",
    "on-click-right": "streamctl toggle-view 4",
    "tooltip": false
  },
  "custom/tag-5": {
    "exec": "streamctl waybar tag 5",
    "return-type": "json",
    "on-click": "streamctl view 5",
    "on-click-right": "streamctl toggle-view 5",
    "tooltip": false
  },
  "custom/tag-6": {
    "exec": "streamctl waybar tag 6",
    "return-type": "json",
    "on-click": "streamctl view 6",
    "on-click-right": "streamctl toggle-view 6",
    "tooltip": false
  },
  "custom/tag-7": {
    "exec": "streamctl waybar tag 7",
    "return-type": "json",
    "on-click": "streamctl view 7",
    "on-click-right": "streamctl toggle-view 7",
    "tooltip": false
  },
  "custom/tag-8": {
    "exec": "streamctl waybar tag 8",
    "return-type": "json",
    "on-click": "streamctl view 8",
    "on-click-right": "streamctl toggle-view 8",
    "tooltip": false
  },
  "custom/tag-9": {
    "exec": "streamctl waybar tag 9",
    "return-type": "json",
    "on-click": "streamctl view 9",
    "on-click-right": "streamctl toggle-view 9",
    "tooltip": false
  },
  "//layout": "Like dwm's layout symbol, plus the master count unless it's 1: click goes back to the previous layout, right click is monocle.",
  "custom/layout": {
    "exec": "streamctl waybar layout",
    "return-type": "json",
    "on-click": "streamctl layout prev",
    "on-click-right": "streamctl layout monocle",
    "tooltip": false
  },
  "custom/mode": {
    "exec": "streamctl waybar mode",
    "return-type": "json",
    "tooltip": false
  },
  "//title": "Like dwm's title: middle click zooms the focused window.",
  "custom/title": {
    "exec": "streamctl waybar title",
    "return-type": "json",
    "escape": true,
    "max-length": 90,
    "on-click-middle": "streamctl zoom",
    "tooltip": false
  },

  "cpu": { "interval": 2, "format": "cpu {usage}%", "tooltip": false },
  "memory": { "interval": 2, "format": "mem {used:0.1f}/{total:0.1f} Gi", "tooltip-format": "{used:0.1f} / {total:0.1f} GiB" },
  "battery": {
    "bat": "BAT0",
    "interval": 5,
    "states": { "warning": 25, "critical": 12 },
    "format": "bat {capacity}% [-]",
    "format-discharging": "bat {capacity}% [-]",
    "format-charging": "bat {capacity}% [+]",
    "format-plugged": "bat {capacity}% [o]",
    "format-full": "bat {capacity}% [o]",
    "tooltip-format": "{timeTo}"
  },
  "//volume": "Click drops down the volume slider (wvol), right click mutes, scrolling steps by 5%.",
  "wireplumber": {
    "format": "vol {volume}%",
    "format-muted": "vol mute",
    "scroll-step": 5,
    "max-volume": 150,
    "on-click": "wvol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "{node_name}"
  },
  "clock": {
    "interval": 1,
    "format": "{:%Y-%m-%d %H:%M:%S}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": { "mode": "month", "format": { "today": "<span color='#5fd4c4'><b>{}</b></span>" } }
  },
  "tray": { "spacing": 6, "icon-size": 14 }
}
