#!/bin/sh
# Start the stream session from a TTY. river runs ~/.config/river/init,
# which starts swm and everything else.
export XDG_CURRENT_DESKTOP=river XDG_SESSION_TYPE=wayland
# Qt apps take their colours from the GTK theme (gtk.css, so the active theme).
export QT_QPA_PLATFORM="wayland;xcb" QT_QPA_PLATFORMTHEME=gtk3 SDL_VIDEODRIVER="wayland,x11"
exec river "$@"
