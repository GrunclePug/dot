#!/usr/bin/env bash
# toggle usb mount at /mnt/usb; optional arg picks the partition (default sda1)
mnt=/mnt/usb
dev=/dev/${1:-sda1}
dev=/dev/${dev#/dev/}

if mountpoint -q "$mnt"; then
	sudo umount "$mnt" && echo "unmounted $mnt"
else
	sudo mount -o uid="$(id -u)",gid="$(id -g)",fmask=0022,dmask=0022 "$dev" "$mnt" && echo "mounted $dev at $mnt"
fi
